# Copy this file to .env.local and fill in your own values. Never commit real values.

# Public address of the site (local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Moderators sign in to /moderation with this. Use a long random value:  openssl rand -hex 32
COMMUNITY_MODERATOR_TOKEN=change-me-to-a-long-random-value

# Captcha (Cloudflare Turnstile). Leave CAPTCHA_REQUIRED=false only on your own computer.
CAPTCHA_REQUIRED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional
# NEXT_PUBLIC_PRODUCT_NAME=Community
# NEXT_PUBLIC_COMMUNITY_DEMO=true
# COMMUNITY_ROOT_DOMAIN=example.com
